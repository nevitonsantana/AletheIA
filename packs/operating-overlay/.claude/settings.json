{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash({{INSTALL_CMD}})",
      "Bash({{TEST_CMD}}*)",
      "Bash({{LINT_CMD}}*)",
      "Bash({{BUILD_CMD}})",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push --force*)"
    ]
  }
}
